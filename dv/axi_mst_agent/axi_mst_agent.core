name: "lowrisc:dv:axi_mst_agent:0.1"
description: "AXI_MST DV UVM agent"
filesets:
  files_dv:
    depend:
      - lowrisc:dv:dv_utils
      - lowrisc:dv:dv_lib
    files:
      - axi_mst_if.sv
      - axi_mst_agent_pkg.sv
      - axi_mst_item.sv: {is_include_file: true}
      - axi_mst_agent_cfg.sv: {is_include_file: true}
      - axi_mst_agent_cov.sv: {is_include_file: true}
      - axi_mst_driver.sv: {is_include_file: true}
      - axi_mst_monitor.sv: {is_include_file: true}
      - axi_mst_agent.sv: {is_include_file: true}
      - seq_lib/axi_mst_base_seq.sv: {is_include_file: true}
      - seq_lib/axi_mst_seq_list.sv: {is_include_file: true}
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_dv
