name: "lowrisc:dv:axi_slv_agent:0.1"
description: "AXI_SLV DV UVM agent"
filesets:
  files_dv:
    depend:
      - lowrisc:dv:dv_utils
      - lowrisc:dv:dv_lib
    files:
      - axi_slv_if.sv
      - axi_slv_agent_pkg.sv
      - axi_slv_item.sv: {is_include_file: true}
      - axi_slv_agent_cfg.sv: {is_include_file: true}
      - axi_slv_agent_cov.sv: {is_include_file: true}
      - axi_slv_driver.sv: {is_include_file: true}
      - axi_slv_monitor.sv: {is_include_file: true}
      - axi_slv_agent.sv: {is_include_file: true}
      - seq_lib/axi_slv_base_seq.sv: {is_include_file: true}
      - seq_lib/axi_slv_seq_list.sv: {is_include_file: true}
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_dv
