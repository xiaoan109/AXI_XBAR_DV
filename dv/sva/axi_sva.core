name: "lowrisc:dv:axi_sva:0.1"
description: "AXI assertion modules and bind file."
filesets:
  files_dv:
    depend:
      - lowrisc:tlul:headers
    files:
      - axi_bind.sv
    file_type: systemVerilogSource

  files_formal:
    depend:
      - lowrisc:ip:axi


targets:
  default: &default_target
    filesets:
      - files_dv
