name: "lowrisc:dv:axi_env:0.1"
description: "AXI DV UVM environment"
filesets:
  files_dv:
    depend:
      - lowrisc:dv:dv_lib
      - lowrisc:dv:axi_mst_agent
      - lowrisc:dv:axi_slv_agent
      - lowrisc:dv:clk_rst_agent
    files:
      - axi_env_pkg.sv
      - axi_env_cfg.sv: {is_include_file: true}
      - axi_env_cov.sv: {is_include_file: true}
      - axi_virtual_sequencer.sv: {is_include_file: true}
      - axi_scoreboard.sv: {is_include_file: true}
      - axi_env.sv: {is_include_file: true}
      - seq_lib/axi_vseq_list.sv: {is_include_file: true}
      - seq_lib/axi_base_vseq.sv: {is_include_file: true}
      - seq_lib/axi_common_vseq.sv: {is_include_file: true}
      - seq_lib/axi_smoke_vseq.sv: {is_include_file: true}
    file_type: systemVerilogSource


targets:
  default:
    filesets:
      - files_dv
